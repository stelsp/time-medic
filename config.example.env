# timetop configuration — copy to ~/.config/timetop/config.env
# Every value is optional; the defaults below are what you get without a file.

# Where Claude Code keeps its session transcripts.
TRANSCRIPT_DIR=~/.claude/projects

# Idle gap that ends a work session. Two entries closer than this count as
# continuous work; a longer hole is a break and is not billed to you.
GAP_MINUTES=15

# Weekly target, drives the gauge in the dashboard header.
TARGET_HOURS=40

# Git author filter for the SHIPPED section. Empty = each repo's own
# user.email, i.e. your commits.
GIT_AUTHOR=

# Keyboard sensor: input older than this many seconds means nobody was at the
# machine, so those minutes are not counted.
IDLE_SECONDS=180

# Meetings. CALENDAR=1 turns calendar reading on (macOS asks for access once).
# Titles stay off by default: only times, calendar names and a head count are
# read. CALENDARS limits it to named calendars; MEETING_MINUTES ignores slots
# shorter than that.
CALENDAR=0
CALENDAR_TITLES=0
CALENDARS=
MEETING_MINUTES=10

# Slack incoming webhook, used only when you type --slack.
SLACK_WEBHOOK=

# Prices. By default the installed claude CLI's own embedded catalog is used,
# which is what you want. Override only to price a model the CLI does not know,
# or to price another provider's models.
#   PRICES_FILE=~/model_prices_and_context_window.json   # LiteLLM shape, $ per token
#   PRICES=claude-opus-5:5/25/0.5/6.25                   # $ per Mtok: in/out/cache-read/cache-write
PRICES=
PRICES_FILE=

# Rename projects in reports: raw:reported,raw2:reported2
# Useful when a throwaway clone (a bot's duty checkout, a deleted worktree)
# shows up under its directory name instead of the repo it belongs to.
ALIASES=
