# timetop configuration — copy to ~/.config/timetop/config.env
# Every value is optional; the defaults below are what you get without a file.

# Where Claude Code keeps its session transcripts.
TRANSCRIPT_DIR=~/.claude/projects

# Idle gap that ends a work session. Two entries closer than this count as
# continuous work; a longer hole is a break and is not billed to you.
GAP_MINUTES=15

# Weekly target, drives the gauge in the dashboard header.
TARGET_HOURS=40

# Git author filter for the SHIPPED section. Empty = each repo's own
# user.email, i.e. your commits.
GIT_AUTHOR=

# Rename projects in reports: raw:reported,raw2:reported2
# Useful when a throwaway clone (a bot's duty checkout, a deleted worktree)
# shows up under its directory name instead of the repo it belongs to.
ALIASES=
